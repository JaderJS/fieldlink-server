model Client {
  id       Int    @id @default(autoincrement())
  name     String
  property String

  docId String?

  doc Doc? @relation(fields: [docId], references: [cuid])

  orders     Order[]
  properties Property[]
  moreInfos  ClientsMoreInfos?
}

model ClientsMoreInfos {
  id        Int      @id @default(autoincrement())
  clientId  Int      @unique
  city      String
  state     String
  email     String?
  phone     String?
  address   String?
  zipCode   String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id])

  @@map("clients_more_infos")
}

model Equipment {
  id         Int      @id @default(autoincrement())
  nickname   String
  sn         String   @unique
  identifier Int      @unique
  productId  Int
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])

  channelSchema ChannelSchema[]

  archives Archives[]
  stations Station[]
}

model Property {
  id       Int    @id @default(autoincrement())
  title    String
  city     String @default("Desconhecido")
  clientId Int

  updateAt DateTime @updatedAt
  createAt DateTime @default(now())

  client   Client    @relation(fields: [clientId], references: [id])
  stations Station[]
}

enum TypeAnalogSilent {
  CSQ
  TPL
  DPL_N
  DPL_I
}

model Station {
  id         Int      @id @default(autoincrement())
  propertyId Int
  content    String
  rx         Float
  tx         Float
  latitude   Float
  longitude  Float
  isActive   Boolean  @default(false)
  updateAt   DateTime @updatedAt
  createAt   DateTime @default(now())

  property       Property        @relation(fields: [propertyId], references: [id])
  digital        StationDigital?
  analog         StationAnalog?
  equipments     Equipment[]
  groups         Group[]
  channelSchemas ChannelSchema[]
}

model StationDigital {
  id        Int     @id @default(autoincrement())
  stationId Int     @unique
  slot      Int
  colorCode Int
  station   Station @relation(fields: [stationId], references: [id], onUpdate: Cascade, onDelete: Cascade)
}

model StationAnalog {
  id        Int              @id @default(autoincrement())
  stationId Int              @unique
  silent    TypeAnalogSilent
  encoder   Float
  decoder   Float
  station   Station          @relation(fields: [stationId], references: [id], onUpdate: Cascade, onDelete: Cascade)
}

model ChannelSchema {
  id        Int    @id @default(autoincrement())
  title     String
  content   Json?
  stationId Int

  equipments      Equipment[]
  channelsAnalog  ChannelAnalogOnChannelSchema[]
  channelsDigital ChannelDigitalOnChannelSchema[]
  station         Station                         @relation(fields: [stationId], references: [id])
}

model ChannelDigitalOnChannelSchema {
  channelSchemaId Int
  groupId         Int
  slot            Int
  colorCode       Int
  order           Int @default(autoincrement())

  schema ChannelSchema @relation(fields: [channelSchemaId], references: [id])
  group  Group         @relation(fields: [groupId], references: [id])

  @@id([channelSchemaId, groupId])
}

model ChannelAnalogOnChannelSchema {
  channelSchemaId Int
  silent          TypeAnalogSilent
  encoder         Float
  decoder         Float
  order           Int              @default(autoincrement())

  schema ChannelSchema @relation(fields: [channelSchemaId], references: [id])

  @@id([channelSchemaId])
}

model Group {
  id         Int      @id @default(autoincrement())
  title      String
  type       String
  identifier Int
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  stations Station[]
  channels ChannelDigitalOnChannelSchema[]
}
