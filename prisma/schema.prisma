// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  ROOT
}

model User {
  cuid      String   @id @default(cuid())
  email     String   @unique
  name      String
  nickname  String   @unique
  avatarUrl String
  role      Role
  password  String
  isEnable  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  myCompany             Company[]
  myBanks               Bank[]
  myTransactionsCreated Transactions[] @relation("transactionsCreatedBy")
  myTransactionsUpdated Transactions[] @relation("transactionsUpdatedBy")

  myArchives        Archives[] @relation("ownerArchives")
  myCreatedArchives Archives[] @relation("createdArchives")
  myUpdatedArchives Archives[] @relation("updatedArchives")
  myDailies         Daily[]
}

enum TypeTransaction {
  INPUT
  OUTPUT
}

model TransactionGroup {
  id            Int          @id @default(autoincrement())
  transactionId Int
  transaction   Transactions @relation(fields: [transactionId], references: [id], onUpdate: Cascade, onDelete: Cascade)
}

model Transactions {
  id          Int             @id @default(autoincrement())
  title       String
  type        TypeTransaction
  description String?
  isDelete    Boolean         @default(false)
  hasNfe      Boolean         @default(false)
  value       Float
  billed      Boolean         @default(false)
  createCuid  String
  updatedCuid String
  companyId   Int
  bankId      Int
  periodId    Int
  hasNotify   Boolean         @default(false)
  serviceId   Int?
  cartId      Int?
  orderId     Int?
  eventId     String?

  content             String   @default("")
  fromAt              DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  parentTransactionId Int?

  rootTransaction   Transactions?  @relation("parentTransaction", fields: [parentTransactionId], references: [id])
  groupTransactions Transactions[] @relation("parentTransaction")

  group TransactionGroup[]

  company   Company @relation(fields: [companyId], references: [id])
  bank      Bank    @relation(fields: [bankId], references: [id])
  period    Period  @relation(fields: [periodId], references: [id])
  createdBy User    @relation("transactionsCreatedBy", fields: [createCuid], references: [cuid])
  updatedBy User    @relation("transactionsUpdatedBy", fields: [updatedCuid], references: [cuid])

  archives   Archives[]
  categories CategoryTransaction[]
}

model GoogleTokens {
  id     Int  @id @default(autoincrement())
  tokens Json
}

model Archives {
  cuid        String   @id @default(cuid())
  title       String
  size        String
  type        String
  path        String
  pathUrl     String
  createdCuid String
  updatedCuid String
  ownerCuid   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner     User @relation("ownerArchives", fields: [ownerCuid], references: [cuid])
  createdBy User @relation("createdArchives", fields: [createdCuid], references: [cuid])
  updatedBy User @relation("updatedArchives", fields: [updatedCuid], references: [cuid])

  transaction Transactions[]
  equipments  Equipment[]
}

enum ServiceType {
  STARTED
  PENDING
  FINISHED
  DROPPED
}

model Period {
  id           Int            @id @default(autoincrement())
  startTime    DateTime
  endTime      DateTime
  name         String         @unique
  order        Int            @default(0)
  transactions Transactions[]
}

model parentTransaction {
  id                 Int @id @default(autoincrement())
  n                  Int
  firstTransactionId Int
}

model CategoryTransaction {
  id   Int    @id @default(autoincrement())
  name String

  transactions Transactions[]
}

enum ProductDiscountType {
  NONE
  PERCENT
  AMOUNT
}

model Supplier {
  id        Int    @id @default(autoincrement())
  name      String @unique
  purchases Cart[]
}

model Client {
  id       Int    @id @default(autoincrement())
  name     String
  property String @default("")

  orders     Order[]
  properties Property[]
}

enum TypeProduct {
  UND
  m
  L
  g
}

enum OrderStatusType {
  PROCESS
  INIT
  FINISHED
}

model Bank {
  id                         Int      @id @default(autoincrement())
  name                       String
  pix                        String
  limitBankingMovements      Float    @default(0)
  limitBankingMovementsMonth Float    @default(0)
  ownerCuid                  String
  updatedBy                  String
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  owner        User           @relation(fields: [ownerCuid], references: [cuid])
  transactions Transactions[]
}

model Company {
  id        Int      @id @default(autoincrement())
  name      String
  cnpj      String
  ownerCuid String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner        User           @relation(fields: [ownerCuid], references: [cuid])
  transactions Transactions[]
}

model Daily {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  content     String
  isActive    Boolean  @default(true)
  ownerCuid   String
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
  owner       User     @relation(fields: [ownerCuid], references: [cuid])
}

//NEW MODELS

model Property {
  id       Int    @id @default(autoincrement())
  title    String
  clientId Int

  updateAt DateTime @updatedAt
  createAt DateTime @default(now())

  client  Client    @relation(fields: [clientId], references: [id])
  station Station[]
}

enum TypeAnalogSilent {
  CSQ
  TPL
  DPL_N
  DPL_I
}

model Station {
  id         Int      @id @default(autoincrement())
  propertyId Int
  content    String
  rx         Float
  tx         Float
  latitude   Float
  longitude  Float
  isActive   Boolean  @default(false)
  updateAt   DateTime @updatedAt
  createAt   DateTime @default(now())

  property                 Property                        @relation(fields: [propertyId], references: [id])
  digital                  StationDigital?
  analog                   StationAnalog?
  equipments               Equipment[]
  groups                   Group[]
  channelsAnalogOnStation  ChannelAnalogOnChannelSchema[]
  channelsDigitalOnStation ChannelDigitalOnChannelSchema[]
}

model StationDigital {
  id        Int     @id @default(autoincrement())
  stationId Int     @unique
  slot      Int
  colorCode Int
  station   Station @relation(fields: [stationId], references: [id], onUpdate: Cascade, onDelete: Cascade)
}

model StationAnalog {
  id        Int              @id @default(autoincrement())
  stationId Int              @unique
  silent    TypeAnalogSilent
  encoder   Float
  decoder   Float
  station   Station          @relation(fields: [stationId], references: [id], onUpdate: Cascade, onDelete: Cascade)
}

model Equipment {
  id         Int      @id @default(autoincrement())
  nickname   String
  sn         String   @unique
  identifier Int      @unique
  productId  Int
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  channelSchema ChannelSchema[]

  archives Archives[]
  stations Station[]
}

model ChannelSchema {
  id      Int    @id @default(autoincrement())
  title   String
  content String

  equipments      Equipment[]
  channelsAnalog  ChannelAnalogOnChannelSchema[]
  channelsDigital ChannelDigitalOnChannelSchema[]
}

model ChannelDigitalOnChannelSchema {
  channelSchemaId Int
  stationId       Int
  groupId         Int
  slot            Int
  order           Int

  schema  ChannelSchema @relation(fields: [channelSchemaId], references: [id])
  station Station       @relation(fields: [stationId], references: [id])
  group   Group         @relation(fields: [groupId], references: [id])

  @@id([channelSchemaId, stationId, groupId])
}

model ChannelAnalogOnChannelSchema {
  channelSchemaId Int
  stationId       Int
  order           Int

  schema  ChannelSchema @relation(fields: [channelSchemaId], references: [id])
  station Station       @relation(fields: [stationId], references: [id])

  @@id([channelSchemaId, stationId])
}

model Group {
  id         Int      @id @default(autoincrement())
  title      String
  type       String
  identifier Int
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  stations Station[]
  channels ChannelDigitalOnChannelSchema[]
}

model Doc {
  cuid      String   @id @default(cuid())
  title     String
  content   String
  createdAt DateTime @default(now())

  orders Order[]
  works  Work[]
}

//NEW

model CategoryOrder {
  id   Int    @id @default(autoincrement())
  name String @unique

  order Order[]
}

model Order {
  id         Int     @id @default(autoincrement())
  title      String
  total      Float
  categoryId Int
  clientId   Int
  docCuid    String?

  works Work[]
  sales Sale[]

  client   Client        @relation(fields: [clientId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  category CategoryOrder @relation(fields: [categoryId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  doc      Doc?          @relation(fields: [docCuid], references: [cuid], onUpdate: Cascade, onDelete: Cascade)
}

model Cart {
  id             Int               @id @default(autoincrement())
  total          Float
  supplierId     Int
  createdAt      DateTime
  productsOnCart ProductsOnCarts[]

  supplier Supplier @relation(fields: [supplierId], references: [id], onUpdate: Cascade, onDelete: Cascade)
}

model ProductsOnCarts {
  cartId    Int
  productId Int

  cart    Cart   @relation(fields: [cartId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@id([cartId, productId])
}

model Sale {
  id        Int      @id @default(autoincrement())
  total     Float
  orderId   Int
  createdAt DateTime @default(now())

  productsOnSale ProductsOnSales[]
  works          Work[]
  otherValues    OtherValues[]
  order          Order            @relation(fields: [orderId], references: [id], onUpdate: Cascade, onDelete: Cascade)
}

model ProductsOnSales {
  saleId    Int
  productId Int
  quantity  Int
  price     Float
  sale      Sale    @relation(fields: [saleId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@id([saleId, productId])
}

enum UnityProduct {
  und
  m
  l
  g
}

model Product {
  id          Int          @id @default(autoincrement())
  name        String
  price       Float
  cost        Float
  stock       Int
  unity       UnityProduct @default(und)
  pictureUrl  String
  description String?
  createdAt   DateTime

  categories     CategoryProduct[]
  salesOnProduct ProductsOnSales[]
  cartsOnProduct ProductsOnCarts[]
  histories      HistoryProduct[]
}

model CategoryProduct {
  id       Int       @id @default(autoincrement())
  name     String
  products Product[]
}

model HistoryProduct {
  id        Int      @id @default(autoincrement())
  productId Int
  price     Float
  cost      Float
  stock     Int
  createdAt DateTime @default(now())

  product Product @relation(references: [id], fields: [productId], onUpdate: Cascade, onDelete: Cascade)
}

model Work {
  id      Int     @id @default(autoincrement())
  total   Float
  orderId Int
  docCuid String?

  order       Order         @relation(fields: [orderId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  doc         Doc?          @relation(fields: [docCuid], references: [cuid], onUpdate: Cascade, onDelete: Cascade)
  sales       Sale[]
  otherValues OtherValues[]
}

model OtherValues {
  id    Int    @id @default(autoincrement())
  name  String
  price Float

  works Work[]
  sales Sale[]
}
